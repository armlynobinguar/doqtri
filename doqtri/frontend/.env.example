# Copy to .env.local and fill in. Only the Supabase block is required to run the app.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI import and regenerate (optional) ---
OPENAI_API_KEY=
# OPENAI_MODEL=
# AI_DAILY_LIMIT=

# --- Stellar network (optional; defaults to the public testnet contract) ---
# NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# NEXT_PUBLIC_CONTRACT_ID=CCB5DFZRFFDCIBV5H5KWO6UCVN4ZXIPUSXONMBA6HVF433SPO7YEWMSB
# NEXT_PUBLIC_SOROBAN_RPC_URL=
# NEXT_PUBLIC_HORIZON_URL=

# --- Passkey wallets: relayer that submits writes for email accounts (optional) ---
# DOQTRI_RELAYER_SECRET=
# CHANNELS_API_KEY=

# --- GitHub links on mindmap nodes (optional; raises the API rate limit) ---
# GITHUB_TOKEN=

# --- Sign-up captcha (optional) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Admin and limits (optional) ---
# DOQTRI_ADMINS=
# CHAIN_WRITES_PER_USER_DAILY=
# CHAIN_WRITES_GLOBAL_DAILY=
# CHAIN_DEPLOYS_PER_USER_DAILY=
# CHAIN_DEPLOYS_GLOBAL_DAILY=
# CHAIN_MAX_RESOURCE_FEE_STROOPS=
