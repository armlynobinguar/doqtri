# Copy to .env.local and fill in. Only the Supabase block is required to run the app.

# --- Supabase (required) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI import and regenerate (optional) ---
OPENAI_API_KEY=
# OPENAI_MODEL=
# AI_DAILY_LIMIT=

# --- Stellar network (optional; defaults to the public testnet contract) ---
# NEXT_PUBLIC_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# NEXT_PUBLIC_CONTRACT_ID=CCCIDUCFQMTMAGESMPTB3MFW4TURS62ORSZNICFOE6MNQZO3MI7F6QRJ
# Template marketplace; unset on mainnet switches it off
# NEXT_PUBLIC_MARKET_CONTRACT_ID=CA6YPRXQ2IFGACBFLKWEFETGLZ2C5R7DG5TTBKTTP4AVYOF3HFOSBCC2
# Soroban RPC (DOQ-7). Both unset, the app uses the public SDF endpoint for the
# network, which is rate-limited and shared. For a dedicated provider, set
# SOROBAN_RPC_URL: server code (API routes, the relay, chain jobs, server
# rendering) uses it first, and it is never sent to the browser, so a URL that
# carries an API key goes here and only here. Server-only.
# SOROBAN_RPC_URL=
# The browser's RPC (wallet reads and simulations), also the server's when
# SOROBAN_RPC_URL is unset. NEXT_PUBLIC_ values are inlined into the JS bundle
# anyone can read: put a keyed URL here only with a key the provider restricts
# to this site's domain. This one is inlined at build time, so changing it
# needs a rebuild; SOROBAN_RPC_URL is read at runtime, so a redeploy is enough.
# NEXT_PUBLIC_SOROBAN_RPC_URL=
# Horizon, used by both browser and server. Public in the same way: a keyed URL
# needs a domain-restricted key. Changing it needs a rebuild and redeploy.
# NEXT_PUBLIC_HORIZON_URL=
# Workspace editors on-chain (WP-1.4): team notes are written with the registry's
# *_as calls and assigned to their workspace. Needs the v3 registry (WP-1.3);
# leave unset until the deployed registry is upgraded.
# NEXT_PUBLIC_REGISTRY_EDITORS=1

# --- Workspace members on-chain (WP-1.5; used only with NEXT_PUBLIC_REGISTRY_EDITORS) ---
# The revoke-only key the contract admin registers with set_revoker. It removes
# a member on-chain as soon as the app removes them (D-16). Server-only.
# REVOKER_SECRET_KEY=
# The registry's contract admin key, only for moving a team workspace's on-chain
# owner to its longest-standing admin when the last owner deletes their account
# (D-31, D-36). Usually unset: those handovers then wait for the product owner.
# CONTRACT_ADMIN_SECRET=
# Bearer token for the scheduled GET /api/chain/jobs, which retries pending removals.
# Vercel Cron sends it once a day (vercel.json, Hobby-safe); the database's pg_cron
# job sends it every minute once the same value is stored in Supabase Vault as
# doqtri_cron_secret, with the route's URL as doqtri_chain_jobs_url
# (backend/migrations/20261025090000_chain_jobs_scheduler.sql). Server-only.
# CRON_SECRET=

# --- Passkey wallets: relayer that submits writes for email accounts (optional) ---
# DOQTRI_RELAYER_SECRET=
# Only with a relayer key other than the built-in testnet relayer: that key's
# public account (G…). Paid writes refuse to run when the two disagree.
# NEXT_PUBLIC_DOQTRI_RELAYER=
# CHANNELS_API_KEY=
# Relay pool (WP-4.1): user-paid writes are sent from a pool of channel accounts
# instead of the relayer alone. Each channel's key is derived from this seed and
# its index, so the database holds public keys only. At least 32 characters
# (openssl rand -hex 32). Server-only. Changing it orphans the funded channels:
# run scripts/seed-relay-channels.mjs again with the new value.
# RELAY_CHANNEL_SEED=
# "on" sends user-paid writes from the leased channels above (needs
# RELAY_CHANNEL_SEED and a seeded relay_channels table); anything else, unset
# included, keeps the relayer as the only source. Channels pay their own network
# fees, so keep them funded. Server-only; switch it back off to roll back.
# RELAY_POOL=on
# "on" logs one "[chain/relay] timing {...}" line per pooled paid write: how
# long each step took (lease, chain state, simulations, submit, poll, release)
# and the ledgers it was sent and landed in. Public facts only, no keys or
# URLs. Off by default; the load test reads these lines (DOQ-8). Server-only.
# RELAY_TIMING=on

# --- qdit integration (WP-2.3; off unless NEXT_PUBLIC_QDIT_INTEGRATION=1) ---
# Connected apps in the profile: each user connects their own qdit account over
# OAuth 2.1 (qdit is the provider, doqtri a confidential client). Names follow
# docs/integration/CONTRACT.md section 1; all five below are needed.
# NEXT_PUBLIC_QDIT_INTEGRATION=1
# qdit's /api/v1 base, e.g. https://qdit.app/api/v1 in production.
# QDIT_API_BASE_URL=
# qdit's Supabase Auth URL, https://<qdit-project-ref>.supabase.co/auth/v1.
# QDIT_OAUTH_ISSUER=
# The client registered for doqtri in qdit's OAuth server. Server-only.
# QDIT_OAUTH_CLIENT_ID=
# QDIT_CLIENT_SECRET=
# Optional: the registered redirect URI. Unset, it is <this origin>/api/integrations/qdit/callback.
# QDIT_OAUTH_REDIRECT_URI=
# Encrypts the stored OAuth tokens (AES-256-GCM): 32 random bytes, base64 or hex
# (openssl rand -base64 32). Server-only. Changing it without the previous key
# below asks everyone to reconnect qdit.
# INTEGRATION_TOKEN_KEY=
# Optional, for a key rotation (D-67): the key INTEGRATION_TOKEN_KEY replaced.
# Tokens are read with either key and sealed again under the current one on
# their next refresh. Keep it for at least qdit's refresh-token lifetime
# (D-81); once removed, a connection still sealed under it needs a reconnect.
# A wrong or swapped INTEGRATION_TOKEN_KEY deletes each user's stored tokens on
# their next qdit request, and putting the old env back does not bring them
# back, so set this in the same deploy that changes the key. An invalid value
# turns the integration off. Runbook: doqtri/backend/README.md, "qdit
# integration operations".
# INTEGRATION_TOKEN_KEY_PREVIOUS=
# Linking notes and headings to qdit projects and milestones (WP-2.5) uses the
# same five. The doc_url qdit links back to is NEXT_PUBLIC_SITE_URL (or the
# Vercel production URL) + /d/<note id>, and qdit accepts only the doqtri
# origin it is configured with (its DOQTRI_ORIGIN, D-45): on a preview, set
# NEXT_PUBLIC_SITE_URL to the origin that preview's qdit expects. The same
# origin builds the public mindmap link each hackathon send carries
# (mindmap_url, <origin>/m/<token>, DOQ-53); only its origin is used, and on a
# site that is not https (local dev) no link is made.
# NEXT_PUBLIC_SITE_URL=
# Status sync (WP-2.8): qdit's webhook, POST /api/integrations/qdit/webhook,
# is signed with this secret (the value qdit keeps in its integration_webhooks
# row for this URL). Unset, the webhook answers 503 and qdit retries later;
# the ship panel still re-reads the chain when it opens. Server-only.
# QDIT_WEBHOOK_SECRET=
# Optional: the Stellar RPC used to read qdit's milestone_proof records, per
# the project's network. Unset, doqtri's own RPC serves its own network and a
# public default the other (soroban-testnet.stellar.org, mainnet.sorobanrpc.com).
# QDIT_CHAIN_RPC_URL_TESTNET=
# QDIT_CHAIN_RPC_URL_MAINNET=
# Public receipts (WP-3.1): /d/<note id> checks headings signed from qdit
# against milestone_proof, and links qdit's public milestone page at the
# origin of QDIT_API_BASE_URL once that page answers an anonymous GET with a
# 200. With QDIT_API_BASE_URL unset there is no qdit link; the receipt stands.
# Hackathon snapshots (WP-4.7, D-117): "1" shows "Send to qdit hackathon" on the
# global mindmap to workspace admins and owners with qdit connected, and turns
# on POST /api/integrations/qdit/hackathon. Needs NEXT_PUBLIC_QDIT_INTEGRATION=1
# too. Empty or anything else hides the button and the route answers 404.
NEXT_PUBLIC_QDIT_HACKATHON=

# --- GitHub links on mindmap nodes (optional; raises the API rate limit) ---
# GITHUB_TOKEN=

# --- Sign-up captcha (optional) ---
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Legal pages (WP-4.6, D-114) ---
# Go-live condition: set this only once the lawyer has reviewed both documents,
# the tax question is answered, and the referral features they describe are merged.
# The operator's name, as /privacy and /terms show it. Unset, both pages are a
# 404, they are absent from the sitemap, every link to them is hidden and the
# sign-up and vault notices do not render. Server-only: never give it a
# NEXT_PUBLIC_ name, and never commit a real value. Some of the pages it affects
# are static, so changing it needs a redeploy.
# LEGAL_OPERATOR_NAME=

# --- Admin and limits (optional) ---
# DOQTRI_ADMINS=
# Hides the referral dashboard, like the legal pages, while empty. Server-only.
# LEGAL_OPERATOR_NAME=
# CHAIN_WRITES_PER_USER_DAILY=
# CHAIN_WRITES_GLOBAL_DAILY=
# CHAIN_DEPLOYS_PER_USER_DAILY=
# CHAIN_DEPLOYS_GLOBAL_DAILY=
# CHAIN_MAX_RESOURCE_FEE_STROOPS=
# CHAIN_MARKET_PER_USER_DAILY=
# CHAIN_MARKET_GLOBAL_DAILY=
# MARKET_PUBLISH_PER_USER_DAILY=
# MARKET_PUBLISH_GLOBAL_DAILY=

# --- Paid-write load test (DOQ-2; read by scripts/load-test only, never by the app) ---
# npm run load:paid-writes. It also needs the Supabase block above, set to the
# deployment under test. Full list and usage: scripts/load-test/README.md.
# The deployment to load (required), e.g. http://localhost:3000.
# LOADTEST_BASE_URL=
# How many wallets send one paid write each, all at once (default 30).
# LOADTEST_N=
# The deployment's log file, to split 502s into txBadSeq / TRY_AGAIN_LATER / other.
# LOADTEST_SERVER_LOG=
# 1 lets the test target anything other than localhost (staging). Off by default.
# LOADTEST_ALLOW_REMOTE=
# Vercel Deployment Protection bypass secret for a protected preview.
# LOADTEST_PROTECTION_BYPASS=
# Optional: LOADTEST_STATE, LOADTEST_OUT, LOADTEST_LABEL, LOADTEST_SETUP_CONCURRENCY,
# LOADTEST_PREPARE_CONCURRENCY, LOADTEST_EMAIL_PREFIX, LOADTEST_EMAIL_DOMAIN,
# LOADTEST_REPORT_FROM (see the README).

# --- Playwright e2e (DOQ-16) ---
# The suite seeds and deletes rows with SUPABASE_SERVICE_ROLE_KEY, and the
# qdit and workspace specs create a second wallet account, team workspaces and
# qdit connections, so it never runs on production. One command makes a
# throwaway Supabase branch "e2e", migrates it from this checkout, runs the
# suite against it and deletes it afterwards (pass/fail/Ctrl+C):
#   npm run test:e2e:staging [-- <playwright args>] [-- --keep]
# It needs a Supabase personal access token (exported, or in
# ~/.config/doqtri-staging/env) and branches the project NEXT_PUBLIC_SUPABASE_URL
# names in .env unless E2E_SUPABASE_PARENT_REF is set. See the header of
# scripts/e2e-staging.mjs.
# SUPABASE_ACCESS_TOKEN=
# E2E_SUPABASE_PARENT_REF=
# E2E_SUPABASE_BRANCH=
#
# Plain `npm run test:e2e` uses whatever Supabase values it finds: .env.e2e
# (the release console's `staging.mjs db --app doqtri` writes it), then
# .env.local, then .env. The qdit and workspace specs run only against a
# project listed here (its ref, the URL's subdomain). Never list production.
# E2E_ALLOWED_SUPABASE_REFS=
#
# Playwright starts a stand-in qdit (e2e/qdit-stub) and gives the dev server
# its QDIT_* values itself; none of them are needed here.
# Optional: the stub's port (default 4010).
# E2E_QDIT_STUB_PORT=
# Reuse a dev server already on :3000 instead of starting one (off: its
# environment may name another Supabase project or a real qdit).
# E2E_REUSE_DEV_SERVER=
